# Copy to .env and edit.  cp .env.example .env

# --- Your inference server ---------------------------------------------------
# Must include the /v1 suffix for OpenAI-compatible servers (vLLM, llama.cpp,
# LM Studio, Ollama, SGLang, TGI...).
#
# NEVER use localhost/127.0.0.1 here: that is the *container's* loopback, which
# has nothing on it. Pick the line that matches your setup.
#
#   Server on your LAN:
# PI_BASE_URL=http://192.168.1.50:8080/v1
#
#   Tunnel run inside compose (recommended -- see README, and start it with
#   `docker compose --profile tunnel up -d tunnel`). No host-networking magic,
#   works the same on macOS and Linux.
PI_BASE_URL=http://tunnel:11666/v1
#
#   SSH tunnel on the host, Docker Desktop (macOS/Windows):
#     Do NOT add extra_hosts for host.docker.internal -- Desktop already
#     provides it, and overriding it points at the VM's bridge, not your host.
#     Whether Desktop forwards to a tunnel bound on the host's 127.0.0.1 varies;
#     if you get 503s, bind the tunnel to 0.0.0.0 or use the tunnel service.
# PI_BASE_URL=http://host.docker.internal:11666/v1
#
#   SSH tunnel on the host, Linux:
#     the pinned gateway of the pi-outbound bridge = your host, seen from the
#     proxy. Bind the tunnel there, not to 127.0.0.1. See README.
# PI_BASE_URL=http://172.28.166.1:11666/v1

# --- Only needed for the `tunnel` profile ------------------------------------
# SSH_TARGET=me@gpu-box            # what you'd type after `ssh`
# SSH_REMOTE=127.0.0.1:11434       # the endpoint as seen from the remote box
# TUNNEL_PORT=11666                # port the tunnel listens on, inside compose

# The auth token. Many local servers ignore it but still require the header to
# be present; any non-empty string works then. This value is passed through the
# container's environment and referenced from models.json as `$PI_API_KEY`, so
# it is never written to the ~/.pi volume.
PI_API_KEY=dummy

# The model id exactly as your server reports it at GET /v1/models.
PI_MODEL_ID=qwen3-coder-30b

# --- Optional ----------------------------------------------------------------
# PI_MODEL_NAME=Qwen3 Coder 30B        # display label in the /model picker
# PI_PROVIDER=local                    # provider namespace inside pi
# PI_CONTEXT_WINDOW=131072
# PI_MAX_TOKENS=16384
# PI_REASONING=false                   # true if the model emits thinking blocks
# PI_VERSION=latest                    # pin the pi npm version

# Quirks for partially-compatible servers. Common ones:
#   supportsDeveloperRole      false for llama.cpp / older vLLM
#   supportsReasoningEffort    false for most local servers
#   supportsUsageInStreaming   false if token counts never show up
# PI_COMPAT_JSON={"supportsDeveloperRole":false,"supportsReasoningEffort":false}

# Custom skills. Both take effect on the next `./pi` -- no rebuild needed.
#
# ONE directory, mounted read-only at /opt/pi-skills by compose. Must be an
# absolute path ('~' is not expanded by compose); relative resolves against
# this directory. Defaults to the bundled ./skills.
# PI_SKILLS_DIR=/home/user/my-custom-skills
#
# MANY directories, colon-separated like PATH. Each is mounted read-only under
# /opt/pi-skills.d/NN-<basename> by the `pi` wrapper, and the whole parent is
# registered once (discovery recurses). '~' IS expanded here. Directories that
# don't exist are skipped with a warning. Paths containing ':' are not
# supported -- use PI_SKILLS_DIR for one of those.
#
# Order matters: on duplicate skill *names*, pi keeps the first one found, so
# earlier entries win.
# PI_SKILLS_DIRS=/home/user/my-custom-skills:~/team-skills:/opt/shared/skills

# Extra system packages, installed with apt at build time. Space-separated.
# Requires a rebuild: `docker compose build agent`.
#
# Version pins work: `curl=7.88.1-10+deb12u5`. Unknown packages fail the build.
# This is the ONLY way to add system packages -- the agent runs unprivileged
# with all capabilities dropped and cannot apt-install at runtime.
#
# Installed before PI_PIP_PACKAGES, so put build dependencies here (e.g.
# libpq-dev) and the Python package that needs them there (psycopg2).
# PI_APT_PACKAGES=ripgrep fd-find postgresql-client libpq-dev

# Extra Python packages, installed into the container's venv at build time.
# Space-separated. Requires a rebuild: `docker compose build agent`.
#
# Write version specs with no spaces: `pandas>=2.0`, never `pandas >= 2.0`
# (the list is word-split, so spaces inside one spec make three packages).
# A '>' here is safe -- it is not a shell redirection.
#
# The agent can also `pip install` at runtime (the venv is writable), but those
# packages vanish when the container exits, and must pass the proxy allowlist.
# Anything listed here is baked into the image and always present.
# PI_PIP_PACKAGES=pandas>=2.0 requests httpx[http2] ruff

# Pi extensions to bake into the image at build time. Space-separated, same
# syntax `pi install` accepts (npm:, git:, a bare https:// URL). Requires a
# rebuild to take effect: `docker compose build agent`.
#
# Order matters for pi-extension-settings specifically: it must come before
# any extension that registers settings with it, or those registrations are
# silently dropped (it hands out registration via an event emitted at load
# time). List it first if you use it.
PI_EXTENSIONS=npm:@juanibiapina/pi-extension-settings npm:@juanibiapina/pi-powerbar
